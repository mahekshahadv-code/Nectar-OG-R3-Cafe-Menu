rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }

    match /owners/{uid} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /menuItems/{id} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /settings/{id} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /orders/{id} {
      allow create: if
        request.resource.data.keys().hasAll([
          'customerName', 'phone', 'orderType', 'items', 'total', 'status', 'createdAt'
        ]) &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() >= 2 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 5 &&
        request.resource.data.orderType in ['dine-in', 'takeaway'] &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.status == 'new';

      allow read, update, delete: if isOwner();
    }
  }
}
